              "raw": "{{baseUrl}}/api/events?search=Sprint",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "search",
                  "value": "Sprint"
                }
              ]
            },
            "description": "Case-insensitive title search matching 'Code Sprint 2.0'."
