      "item": [
        {
          "name": "GET /api/events - List All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            },
            "description": "Fetches all 14 events with live available_seats computed as capacity minus registrations."
          },
          "response": []
        },
        {
          "name": "GET /api/events - Filter by Category (Technical)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technical",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "category",
                  "value": "Technical"
                }
              ]
            },
            "description": "Filters events where category matches 'Technical'."
          },
          "response": []
        },
        {
          "name": "GET /api/events - Search by Title (Sprint)",
