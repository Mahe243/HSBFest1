            "description": "Returns full details for event id 1 with available seats."
          },
          "response": []
        },
        {
          "name": "GET /api/events/:event_id - Nonexistent Event (Error 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "9999"]
            },
            "description": "Returns 404 with error message for non-existent event ID."
          },
          "response": []
        }
